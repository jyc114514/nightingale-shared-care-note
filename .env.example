# Local Gate A configuration. Copy to .env and replace placeholders locally.
APP_ENV=development
DATABASE_URL=sqlite:///./nightingale.db
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECURE=false
SESSION_TTL_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_SEED_PASSWORD=replace-with-a-local-demo-password

# Optional provider boundary; fixture is the safe default. Never commit a real key.
LLM_PROVIDER=fixture
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20
DEEPSEEK_MAX_TOKENS=600

# Optional local Ambient Voice prototype. Render/production must keep this disabled.
VOICE_PROVIDER=disabled
VOICE_MODEL=turbo
VOICE_DEVICE=cuda
VOICE_COMPUTE_TYPE=float16
VOICE_MODEL_CACHE_DIR=
